# ============================================================
# Veridex — .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment
.env
.env.local
.env.production
!.env.example

# Node
node_modules/
.next/
out/
.turbo/

# Testing
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Docker
docker-compose.override.yml

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Database
*.db
*.sqlite

# Secrets — NEVER commit
*.pem
*.key
*.cert
secrets/

backend/.venv/
backend/ruff/
backend/ruff.zip
backend/get-pip-log.txt
backend/mypy-errors*.txt
backend/mypy-out*.txt
backend/ruff-errors*.txt
backend/ruff-out*.txt
backend/uv-log*.txt