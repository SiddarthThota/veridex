# ============================================================
# Veridex — Environment Variables
# ============================================================
# Copy this file to .env and customize for your environment.
# NEVER commit .env files with real secrets.
# ============================================================

# Application
VERIDEX_APP_NAME=Veridex
VERIDEX_APP_VERSION=0.1.0
VERIDEX_ENVIRONMENT=development
VERIDEX_DEBUG=true
VERIDEX_LOG_LEVEL=INFO

# Server
VERIDEX_HOST=0.0.0.0
VERIDEX_PORT=8000

# Database
VERIDEX_DATABASE_URL=postgresql+asyncpg://veridex:veridex@localhost:5433/veridex
VERIDEX_DATABASE_ECHO=false

# Redis
VERIDEX_REDIS_URL=redis://localhost:6379/0

# Authentication — CHANGE IN PRODUCTION
VERIDEX_SECRET_KEY=CHANGE-ME-IN-PRODUCTION-USE-A-REAL-SECRET-KEY
VERIDEX_JWT_ALGORITHM=HS256
VERIDEX_ACCESS_TOKEN_EXPIRE_MINUTES=30
VERIDEX_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# AI Provider (mock | openai)
VERIDEX_AI_PROVIDER=mock
VERIDEX_OPENAI_API_KEY=
VERIDEX_OPENAI_MODEL=gpt-4o

# Telemetry
VERIDEX_OTEL_ENABLED=true
VERIDEX_OTEL_SERVICE_NAME=veridex-backend
VERIDEX_OTEL_EXPORTER_ENDPOINT=http://localhost:4317

# CORS
VERIDEX_CORS_ORIGINS=["http://localhost:3000"]

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
